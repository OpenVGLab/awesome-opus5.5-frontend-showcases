---
// Custom HTML5 video player: styled controls, chapters on the scrubber, custom-rendered captions,
// speed, picture-in-picture, fullscreen and YouTube-style keyboard shortcuts.
const { video } = Astro.props;
const src = (p) => `/${p}`;
const iso = video.duration.match(/PT(?:(\d+)M)?(?:(\d+)S)?/) || [];
const seconds = Number(iso[1] || 0) * 60 + Number(iso[2] || 0);
const clock = `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`;
---

<figure class="vp" data-vp data-duration={seconds} tabindex="-1">
  <div class="vp-stage" data-stage>
    <video class="vp-video" preload="none" playsinline poster={src(video.poster)} aria-label={video.title}>
      <source src={src(video.webm)} type="video/webm" />
      <source src={src(video.mp4)} type="video/mp4" />
      <track kind="captions" srclang="en" label="English" src={src(video.captions)} />
      <track kind="chapters" srclang="en" label="Chapters" src={src(video.chapters)} />
      <p>Your browser cannot play this video. <a href={src(video.mp4)}>Download the MP4</a>.</p>
    </video>
    <div class="vp-captions" data-captions aria-hidden="true"></div>
    <button class="vp-big-play" type="button" data-act="play" aria-label="Play video">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5L8 5.5Z" fill="currentColor"></path></svg>
    </button>
    <span class="vp-toast" data-toast aria-hidden="true"></span>
  </div>
  <div class="vp-bar">
    <div class="vp-progress" data-progress>
      <div class="vp-track"><span class="vp-buffer" data-buffer></span><span class="vp-fill" data-fill></span></div>
      <div class="vp-chapters" data-chapters></div>
      <input type="range" min="0" max="1000" step="1" value="0" aria-label="Seek" data-seek />
      <span class="vp-hover" data-hover></span>
    </div>
    <div class="vp-controls" role="group" aria-label="Video controls">
      <button class="vp-btn" type="button" data-act="play" aria-label="Play (k)">
        <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5L8 5.5Z" fill="currentColor"></path></svg>
        <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><rect x="6.5" y="5" width="3.8" height="14" rx="1.2" fill="currentColor"></rect><rect x="13.7" y="5" width="3.8" height="14" rx="1.2" fill="currentColor"></rect></svg>
      </button>
      <button class="vp-btn" type="button" data-act="back" aria-label="Back 5 seconds (j)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7M4 4v4h4"></path><text x="12" y="15.5" font-size="7" text-anchor="middle" fill="currentColor" stroke="none">5</text></svg>
      </button>
      <button class="vp-btn" type="button" data-act="fwd" aria-label="Forward 5 seconds (l)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.4-5.7M20 4v4h-4"></path><text x="12" y="15.5" font-size="7" text-anchor="middle" fill="currentColor" stroke="none">5</text></svg>
      </button>
      <span class="vp-time"><span data-current>0:00</span> <span aria-hidden="true">/</span> <span data-duration>{clock}</span></span>
      <span class="vp-chapter-name" data-chapter-name></span>
      <span class="vp-spacer"></span>
      <button class="vp-btn" type="button" data-act="mute" aria-label="Mute (m)">
        <svg class="i-vol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9.5h3.5L12 5v14l-4.5-4.5H4z"></path><path d="M16 9a4 4 0 0 1 0 6M18.5 6.5a7.5 7.5 0 0 1 0 11"></path></svg>
        <svg class="i-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9.5h3.5L12 5v14l-4.5-4.5H4z"></path><path d="m16 9.5 5 5M21 9.5l-5 5"></path></svg>
      </button>
      <input class="vp-volume" type="range" min="0" max="1" step="0.05" value="0.8" aria-label="Volume" data-volume />
      <button class="vp-btn vp-speed" type="button" data-act="speed" aria-label="Playback speed: 1×">1×</button>
      <button class="vp-btn vp-cc" type="button" data-act="cc" aria-label="CC — captions (c)" aria-pressed="false">CC</button>
      <button class="vp-btn" type="button" data-act="pip" aria-label="Picture in picture" data-pip>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><rect x="12" y="11" width="7" height="6" rx="1" fill="currentColor"></rect></svg>
      </button>
      <button class="vp-btn" type="button" data-act="fs" aria-label="Fullscreen (f)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path></svg>
      </button>
    </div>
  </div>
  <figcaption class="vp-caption"><strong>{video.title}.</strong> {video.description} <span class="vp-keys">Shortcuts: K play/pause · J/L ±5 s · M mute · C captions · F fullscreen</span></figcaption>
</figure>

<script>
  const fmt = (t) => {
    const s = Math.max(0, Math.floor(t || 0));
    return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
  };
  const SPEEDS = [1, 1.25, 1.5, 2, 0.5, 0.75];

  document.querySelectorAll('[data-vp]').forEach((root) => {
    const $ = (s) => root.querySelector(s);
    const video = $('video');
    const seek = $('[data-seek]');
    const fill = $('[data-fill]');
    const buffer = $('[data-buffer]');
    const hover = $('[data-hover]');
    const captionsBox = $('[data-captions]');
    const toast = $('[data-toast]');
    const chaptersBox = $('[data-chapters]');
    const chapterName = $('[data-chapter-name]');
    const volume = $('[data-volume]');
    const speedBtn = $('[data-act="speed"]');
    const ccBtn = $('[data-act="cc"]');
    let captionsOn = false;
    let chapters = [];
    let idleTimer;
    let toastTimer;

    video.volume = Number(volume.value);
    const [captionTrack, chapterTrack] = [...video.textTracks];
    if (captionTrack) captionTrack.mode = 'hidden';
    if (chapterTrack) chapterTrack.mode = 'hidden';

    const flash = (text) => {
      toast.textContent = text;
      toast.classList.add('is-visible');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toast.classList.remove('is-visible'), 700);
    };
    const play = () => (video.paused || video.ended ? video.play().catch(() => {}) : video.pause());
    const skip = (d) => {
      video.currentTime = Math.min(Math.max(0, video.currentTime + d), video.duration || 0);
      flash(`${d > 0 ? '+' : '−'}${Math.abs(d)} s`);
    };
    const setCaptions = (on) => {
      captionsOn = on;
      ccBtn.setAttribute('aria-pressed', String(on));
      root.classList.toggle('cc-on', on);
      renderCue();
      flash(on ? 'Captions on' : 'Captions off');
    };
    const renderCue = () => {
      const cue = captionTrack?.activeCues?.[0];
      captionsBox.textContent = captionsOn && cue ? cue.text : '';
    };
    // Before playback starts (preload="none") the duration comes from the post's frontmatter.
    const knownDuration = () => video.duration || Number(root.dataset.duration) || 0;
    const buildChapters = () => {
      const total = knownDuration();
      if (!chapterTrack?.cues?.length || !total) return;
      chapters = [...chapterTrack.cues].map((c) => ({ start: c.startTime, end: c.endTime, text: c.text }));
      chaptersBox.innerHTML = chapters
        .slice(1)
        .map((c) => `<span style="left:${(c.start / total) * 100}%" title="${c.text}"></span>`)
        .join('');
      updateChapter();
    };
    const updateChapter = () => {
      const c = chapters.find((ch) => video.currentTime >= ch.start && video.currentTime < ch.end);
      chapterName.textContent = c ? `· ${c.text}` : '';
    };
    const update = () => {
      const p = video.duration ? video.currentTime / video.duration : 0;
      fill.style.transform = `scaleX(${p})`;
      seek.value = String(Math.round(p * 1000));
      seek.setAttribute('aria-valuetext', `${fmt(video.currentTime)} of ${fmt(video.duration)}`);
      $('[data-current]').textContent = fmt(video.currentTime);
      updateChapter();
    };
    const updateBuffer = () => {
      if (!video.duration || !video.buffered.length) return;
      buffer.style.transform = `scaleX(${video.buffered.end(video.buffered.length - 1) / video.duration})`;
    };
    const wake = () => {
      root.classList.remove('is-idle');
      clearTimeout(idleTimer);
      if (!video.paused) idleTimer = setTimeout(() => root.classList.add('is-idle'), 2500);
    };

    video.addEventListener('loadedmetadata', () => {
      $('[data-duration]').textContent = fmt(video.duration);
      const start = Number(new URLSearchParams(location.search).get('t'));
      if (start > 0 && start < video.duration) video.currentTime = start;
      buildChapters();
      update();
    });
    chapterTrack?.addEventListener?.('load', buildChapters);
    video.querySelectorAll('track')[1]?.addEventListener('load', buildChapters);
    captionTrack?.addEventListener('cuechange', renderCue);
    video.addEventListener('timeupdate', update);
    video.addEventListener('progress', updateBuffer);
    video.addEventListener('play', () => {
      root.classList.add('is-playing', 'has-started');
      $('[data-act="play"].vp-btn').setAttribute('aria-label', 'Pause (k)');
      wake();
    });
    video.addEventListener('pause', () => {
      root.classList.remove('is-playing');
      $('[data-act="play"].vp-btn').setAttribute('aria-label', 'Play (k)');
      wake();
    });
    video.addEventListener('ended', () => root.classList.remove('is-playing'));
    video.addEventListener('volumechange', () => {
      root.classList.toggle('is-muted', video.muted || video.volume === 0);
      volume.value = video.muted ? '0' : String(video.volume);
    });

    seek.addEventListener('input', () => {
      const total = knownDuration();
      if (total) video.currentTime = (Number(seek.value) / 1000) * total;
    });
    const progress = $('[data-progress]');
    progress.addEventListener('pointermove', (e) => {
      const r = progress.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
      const t = p * knownDuration();
      const ch = chapters.find((c) => t >= c.start && t < c.end);
      hover.textContent = `${fmt(t)}${ch ? ` · ${ch.text}` : ''}`;
      hover.style.left = `${p * 100}%`;
    });
    volume.addEventListener('input', () => {
      video.volume = Number(volume.value);
      video.muted = video.volume === 0;
    });

    const pipBtn = $('[data-pip]');
    if (!document.pictureInPictureEnabled || video.disablePictureInPicture) pipBtn.hidden = true;

    const actions = {
      play,
      back: () => skip(-5),
      fwd: () => skip(5),
      mute: () => {
        video.muted = !video.muted;
        flash(video.muted ? 'Muted' : 'Sound on');
      },
      speed: () => {
        const next = SPEEDS[(SPEEDS.indexOf(video.playbackRate) + 1) % SPEEDS.length];
        video.playbackRate = next;
        speedBtn.textContent = `${next}×`;
        speedBtn.setAttribute('aria-label', `Playback speed: ${next}×`);
        flash(`${next}×`);
      },
      cc: () => setCaptions(!captionsOn),
      pip: () => (document.pictureInPictureElement ? document.exitPictureInPicture() : video.requestPictureInPicture()).catch(() => {}),
      fs: () => (document.fullscreenElement ? document.exitFullscreen() : root.requestFullscreen?.())?.catch?.(() => {}),
    };
    root.querySelectorAll('[data-act]').forEach((b) => b.addEventListener('click', (e) => {
      e.stopPropagation();
      actions[b.dataset.act]();
    }));
    $('[data-stage]').addEventListener('click', play);
    $('[data-stage]').addEventListener('dblclick', actions.fs);
    root.addEventListener('pointermove', wake);
    document.addEventListener('fullscreenchange', () => root.classList.toggle('is-fullscreen', document.fullscreenElement === root));

    root.addEventListener('keydown', (e) => {
      if (e.target.matches('input[type="range"]') && e.key.startsWith('Arrow')) return;
      if (e.target.matches('button') && (e.key === ' ' || e.key === 'Enter')) return;
      const k = e.key.toLowerCase();
      const map = { ' ': play, k: play, j: actions.back, arrowleft: actions.back, l: actions.fwd, arrowright: actions.fwd, m: actions.mute, c: actions.cc, f: actions.fs };
      if (map[k]) {
        e.preventDefault();
        map[k]();
        wake();
      }
    });
  });
</script>
