{
  "name": "mara-ellison-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portfolio of Mara Ellison, creative frontend developer. Next.js (pages router, static export) for the portfolio, Astro for the blog.",
  "scripts": {
    "assets": "node scripts/generate-assets.mjs",
    "data": "node scripts/build-data.mjs",
    "clean": "node -e \"for (const d of ['.next', 'blog/node_modules/.astro', 'blog/.astro', 'dist-blog']) require('fs').rmSync(d, { recursive: true, force: true })\"",
    "build:site": "next build --webpack",
    "build:blog": "astro build --root blog",
    "merge": "node scripts/postbuild.mjs",
    "build": "npm run clean && npm run data && npm run build:site && npm run build:blog && npm run merge",
    "dev:site": "next dev --webpack",
    "dev:blog": "astro dev --root blog"
  },
  "dependencies": {
    "@react-spring/web": "^10.1.2",
    "aos": "2.3.4",
    "chart.js": "^4.5.1",
    "framer-motion": "^13.4.2",
    "gsap": "^3.15.0",
    "lottie-react": "^3.1.2",
    "next": "16.3.6",
    "particles.js": "2.0.0",
    "react": "18.3.1",
    "react-chat-widget": "3.1.4",
    "react-confetti": "^6.4.0",
    "react-custom-cursor": "0.1.1",
    "react-dom": "18.3.1",
    "react-dropzone": "^20.1.2",
    "react-focus-lock": "^2.13.7",
    "react-globe.gl": "^2.38.0",
    "react-masonry-css": "1.0.16",
    "react-mouse-particles": "1.1.5",
    "react-scroll": "^1.9.3",
    "react-tooltip": "^6.0.8",
    "react-wordcloud": "1.2.7",
    "swiper": "^14.2.0",
    "topojson-client": "^3.1.0",
    "web-vitals": "^5.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@astrojs/rss": "^4.0.12",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "astro": "5.18.2",
    "gray-matter": "^4.0.3",
    "mdast-util-to-string": "^4.0.0",
    "opentype.js": "^1.3.4",
    "reading-time": "^1.5.0",
    "sharp": "^0.34.4",
    "three": "0.186.0",
    "unist-util-visit": "^5.0.0"
  },
  "overrides": {
    "react-custom-cursor": {
      "react-scripts": "file:./stubs/empty",
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "react-chat-widget": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "react-wordcloud": {
      "react": "$react"
    }
  }
}
